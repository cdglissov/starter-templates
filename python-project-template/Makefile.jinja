.PHONY: help bootstrap test lint format-check typecheck pre-commit check

help: ## Show available targets
	@awk 'BEGIN {FS = ":.*##"; printf "Usage:\n  make <target>\n\nTargets:\n"} /^[a-zA-Z0-9_-]+:.*##/ {printf "  %-14s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

bootstrap: ## Set up the project for local development
	@if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then \
		echo "Git repository already initialized."; \
	else \
		git init --initial-branch=main; \
	fi
	uv sync --upgrade
	uv run prek autoupdate --cooldown-days 7 \
		--include-tag '*.*.*' \
		--include-tag '*.*' \
		--exclude-tag '*.*.*-*' \
		--exclude-tag '*.*.*.dev*' \
		--exclude-tag '*.*.*a*' \
		--exclude-tag '*.*.*b*' \
		--exclude-tag '*.*.*rc*'
	uv run prek install --install-hooks

test: ## Run all tests
	uv run pytest

lint: ## Run Ruff linting
	uv run ruff check .

format-check: ## Check code formatting
	uv run ruff format --check .

typecheck: ## Run type checking
	uv run pyrefly check

pre-commit: ## Run all pre-commit hooks
	uv run prek run --all-files --show-diff-on-failure

check: pre-commit lint format-check typecheck test ## Run local validation checks