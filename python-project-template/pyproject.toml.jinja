[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
authors = [
    { name = "{{ author_name }}" },
]
requires-python = ">={{ python_version }}"
dependencies = []

[project.scripts]
{{ project_name }} = "{{ package_name }}:main"

[build-system]
requires = ["uv_build>=0.12.0,<0.13"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "coverage[toml]>=7.16.0",
    "prek>=0.5.2",
    "pyrefly>=1.2.0",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
    "ruff>=0.16.6",
    "notebook>=7.6.2",
]

[tool.uv]
default-groups = "all"

[tool.pyrefly]
project-includes = ["src", "tests"]
project-excludes = ["**/.[!/.]*"]
search-path = ["src", "tests"]
python-version = "{{ python_version|replace('.', '') }}"
python-interpreter-path = "{% if host_os == 'windows' %}.venv/Scripts/python.exe{% else %}.venv/bin/python{% endif %}"

[tool.pytest.ini_options]
addopts = [
    "-q",
    "--cov={{ package_name }}",
    "--cov-report=term-missing",
]
testpaths = ["tests"]

[tool.coverage.run]
branch = true
source = ["{{ package_name }}"]

[tool.coverage.report]
show_missing = true
skip_covered = true

[tool.ruff]
line-length = 100
target-version = "py{{ python_version|replace('.', '') }}"

[tool.ruff.lint]
select = [
    "ALL"
]
ignore = [
    "COM812",  # trailing comma conflict
    "TC006",   # quote cast value
    "D100",    # document public module
    "D104",    # Missing docstring in public package
    "D107",    # document public init
    "D203",    # blank line before class docstring
    "D213",    # multi-line summary before class
    "ERA",     # eradicate todos
    "FIX002",  # fix todos
    "TRY003",  # raise vanilla args
    "TD002",   # missing author in TODO
    "TD003",   # missing-todo-link
    "T20",     # pprint and print statement found
    "S603",    # Allow subprocesses from untrusted
    "S607",    # Allow yaml load from untrusted
    "D400",    # Missing punctuation in docstring
    "D413",    # Blank line after end in docstring
    "D415",    # Punctuation in docstring
    "CPY001",  # Copyright notice in header
]

unfixable = []

[tool.ruff.lint.per-file-ignores]
"**/tests/*.py" = [
    "S101",     # asserts allowed in tests...
    "ARG",      # unused function args -> fixtures nevertheless are functionally relevant
    "FBT",      # don't care about booleans as positional arguments in tests, e.g. via @pytest.mark.parametrize()
    "PLR2004",  # magic value used in comparison
    "S311",     # standard pseudo-random generators are not suitable for cryptographic purposes
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.pycodestyle]
max-line-length = 100
